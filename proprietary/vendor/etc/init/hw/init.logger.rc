# Bulletproof Boot Logger Service
# Uses only rootfs (/dev, /sys, /proc) which are always available

on early-init
    # Stage 1: Early kernel logging to tmpfs (always available)
    start early_kernel_log
    start boot_progress_log

on post-fs-data
    # Stage 2: Migrate logs to /data once mounted
    start migrate_early_logs
    start main_logging_services

on property:sys.boot_completed=1
    stop continuous_kernel_log
    stop log_sync_service

# Early kernel logging to tmpfs (ALWAYS available)
service early_kernel_log /system/system/bin/sh /system/system/bin/early_kernel_log.sh
    class core
    user root
    group root system
    oneshot
    seclabel u:r:init:s0

# Boot progress tracking
service boot_progress_log /system/system/bin/sh /system/system/bin/boot_progress_log.sh
    class core
    user root
    group root system
    oneshot
    seclabel u:r:init:s0

# Migrate early logs from tmpfs to /data
service migrate_early_logs /system/system/bin/sh /system/system/bin/migrate_early_logs.sh
    class main
    user root
    group root system
    oneshot
    seclabel u:r:init:s0

# Main logging services (after data mount)
service boot_log /system/system/bin/logcat -b all -f /data/boot_logs/boot_full.txt -v threadtime -r 16384
    class main
    user root
    group root system
    disabled
    oneshot

service continuous_kernel_log /system/system/bin/sh /system/system/bin/continuous_kernel_log.sh
    class main
    user root
    group root system
    disabled
    seclabel u:r:shell:s0

on post-fs-data
    # Enable main logging
    start boot_log
    start boot_log_crash
    start boot_log_kernel
    start continuous_kernel_log