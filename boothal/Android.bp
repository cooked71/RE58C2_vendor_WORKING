// ===== Boot HAL service binary =====
cc_prebuilt_binary {
    name: "android.hardware.boot@1.2-service",
    vendor: true,
    srcs: ["../../proprietary/vendor/bin/hw/vendor.sprd.hardware.boot@1.2-service"],
    relative_install_path: "bin/hw",
    stl: "none",
    strip: { none: true },
}

// ===== Implementation libraries (vendor) =====
cc_prebuilt_library_shared {
    name: "android.hardware.boot@1.2-impl_64",
    vendor: true,
    srcs: ["../../proprietary/vendor/lib64/hw/android.hardware.boot@1.0-impl-1.2.so"],
    compile_multilib: "64",
    stl: "none",
    strip: { none: true },
    relative_install_path: "lib64/hw",
}

cc_prebuilt_library_shared {
    name: "android.hardware.boot@1.2-impl_32",
    vendor: true,
    srcs: ["../../proprietary/vendor/lib/hw/android.hardware.boot@1.0-impl-1.2.so"],
    compile_multilib: "32",
    stl: "none",
    strip: { none: true },
    relative_install_path: "lib/hw",
}

// ===== Bootctrl libraries (vendor) =====
cc_prebuilt_library_shared {
    name: "bootctrl.default_64",
    vendor: true,
    srcs: ["../../proprietary/vendor/lib64/hw/bootctrl.default.so"],
    compile_multilib: "64",
    stl: "none",
    strip: { none: true },
