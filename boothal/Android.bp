// =============================================================================
// RE58C2 Boot HAL and Bootctrl Prebuilts for LineageOS 20
// =============================================================================

// ===== SERVICE BINARIES =====
cc_prebuilt_binary {
    name: "android.hardware.boot@1.2-service",
    srcs: "vendor/realme/RE58C2/proprietary/vendor/bin/hw/vendor.sprd.hardware.boot@1.2-service",
    vendor: true,
    relative_install_path: "bin/hw",
}

cc_prebuilt_binary {
    name: "android.hardware.boot@1.2-service.recovery",
    srcs: "vendor/realme/RE58C2/proprietary/vendor/bin/hw/vendor.sprd.hardware.boot@1.2-service_2",
    vendor: true,
    relative_install_path: "recovery/root/vendor/bin/hw",
}

// ===== IMPLEMENTATION LIBRARIES =====
cc_prebuilt_library_shared {
    name: "android.hardware.boot@1.2-impl",
    vendor: true,
    srcs: [
        "vendor/realme/RE58C2/proprietary/vendor/lib64/hw/android.hardware.boot@1.0-impl-1.2.so",
        "vendor/realme/RE58C2/proprietary/vendor/lib/hw/android.hardware.boot@1.0-impl-1.2.so",
    ],
    compile_multilib: "both",
    shared_libs: [],
    stl: "none",
    strip: { none: true },
}

cc_prebuilt_library_shared {
    name: "android.hardware.boot@1.2-impl.recovery",
    vendor: true,
    srcs: [
        "vendor/realme/RE58C2/proprietary/vendor_boot/ramdisk/system/lib64/hw/android.hardware.boot@1.0-impl-1.2.so",
    ],
    compile_multilib: "64",
    shared_libs: [],
    stl: "none",
    strip: { none: true },
}

// ===== INTERFACE LIBRARIES (VENDOR_BOOT) =====
cc_prebuilt_library_shared {
    name: "android.hardware.boot.iface",
    vendor: true,
    srcs: [
        "vendor/realme/RE58C2/proprietary/vendor_boot/ramdisk/system/lib64/android.hardware.boot@1.2.so",
        "vendor/realme/RE58C2/proprietary/vendor_boot/ramdisk/system/lib64/android.hardware.boot@1.1.so",
        "vendor/realme/RE58C2/proprietary/vendor_boot/ramdisk/system/lib64/android.hardware.boot@1.0.so",
        "vendor/realme/RE58C2/proprietary/vendor_boot/ramdisk/system/lib64/vendor.sprd.hardware.boot@1.2.so",
    ],
    compile_multilib: "64",
    shared_libs: [],
    stl: "none",
    strip: { none: true },
}

// ===== BOOTCTRL LIBRARIES =====
cc_prebuilt_library_shared {
    name: "bootctrl.default",
    vendor: true,
    srcs: [
        "vendor/realme/RE58C2/proprietary/vendor/lib64/hw/bootctrl.default.so",
        "vendor/realme/RE58C2/proprietary/vendor/lib/hw/bootctrl.default.so",
    ],
    compile_multilib: "both",
    shared_libs: [],
    stl: "none",
    strip: { none: true },
}

cc_prebuilt_library_shared {
    name: "bootctrl.default.recovery",
    vendor: true,
    srcs: [
        "vendor/realme/RE58C2/proprietary/vendor/lib64/hw/bootctrl.default.so",
        "vendor/realme/RE58C2/proprietary/vendor/lib/hw/bootctrl.default.so",
    ],
    compile_multilib: "both",
    shared_libs: [],
    stl: "none",
    strip: { none: true },
}

cc_prebuilt_library_shared {
    name: "unisoc.bootctrl",
    vendor: true,
    srcs: [
        "vendor/realme/RE58C2/proprietary/vendor/lib64/hw/unisoc.bootctrl.so",
        "vendor/realme/RE58C2/proprietary/vendor/lib/hw/unisoc.bootctrl.so",
    ],
    compile_multilib: "both",
    shared_libs: [],
    stl: "none",
    strip: { none: true },
}

cc_prebuilt_library_shared {
    name: "unisoc.bootctrl.recovery",
    vendor: true,
    srcs: [
        "vendor/realme/RE58C2/proprietary/vendor/lib64/hw/unisoc.bootctrl.so",
        "vendor/realme/RE58C2/proprietary/vendor/lib/hw/unisoc.bootctrl.so",
    ],
    compile_multilib: "both",
    shared_libs: [],
    stl: "none",
    strip: { none: true },
}
