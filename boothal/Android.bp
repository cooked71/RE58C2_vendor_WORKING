// =============================================================================
// RE58C2 Boot HAL Android.bp
// =============================================================================

package {
    default_applicable_licenses: ["Android-Apache-2.0"],
}

// ===================== SERVICE BINARIES =====================
cc_prebuilt_binary {
    name: "android.hardware.boot@1.2-service",
    vendor: true,
    srcs: ["proprietary/vendor/bin/hw/vendor.sprd.hardware.boot@1.2-service"],
    relative_install_path: "bin/hw",
}

cc_prebuilt_binary {
    name: "android.hardware.boot@1.2-service.recovery",
    vendor: true,
    srcs: ["proprietary/vendor/bin/hw/vendor.sprd.hardware.boot@1.2-service_2"],
    relative_install_path: "recovery/root/vendor/bin/hw",
}

// ===================== IMPLEMENTATION LIBRARIES =====================
// 64-bit vendor
cc_prebuilt_library_shared {
    name: "android.hardware.boot@1.2-impl_64",
    vendor: true,
    srcs: ["proprietary/vendor/lib64/hw/android.hardware.boot@1.0-impl-1.2.so"],
    compile_multilib: "64",
    stl: "none",
    strip: { none: true },
}

// 32-bit vendor
cc_prebuilt_library_shared {
    name: "android.hardware.boot@1.2-impl_32",
    vendor: true,
    srcs: ["proprietary/vendor/lib/hw/android.hardware.boot@1.0-impl-1.2.so"],
    compile_multilib: "32",
    stl: "none",
    strip: { none: true },
}

// 64-bit recovery
cc_prebuilt_library_shared {
    name: "android.hardware.boot@1.2-impl_64_recovery",
    vendor: true,
    srcs: ["proprietary/vendor_boot/ramdisk/system/lib64/hw/android.hardware.boot@1.0-impl-1.2.so"],
    compile_multilib: "64",
    stl: "none",
    strip: { none: true },
    relative_install_path: "recovery/root/vendor/lib64/hw",
}

// ===================== VENDOR_BOOT INTERFACE LIBRARIES =====================
cc_prebuilt_library_shared {
    name: "android.hardware.boot@1.2_if_64_recovery",
    vendor: true,
    srcs: ["proprietary/vendor_boot/ramdisk/system/lib64/android.hardware.boot@1.2.so"],
    compile_multilib: "64",
    stl: "none",
    strip: { none: true },
    relative_install_path: "recovery/root/system/lib64",
}

