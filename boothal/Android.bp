    srcs: ["proprietary/vendor_boot/ramdisk/system/lib64/android.hardware.boot@1.1.so"],
    compile_multilib: "64",
    stl: "none",
    strip: { none: true },
    relative_install_path: "recovery/root/system/lib64",
}

cc_prebuilt_library_shared {
    name: "android.hardware.boot@1.0_if_64_recovery",
    vendor: true,
    srcs: ["proprietary/vendor_boot/ramdisk/system/lib64/android.hardware.boot@1.0.so"],
    compile_multilib: "64",
    stl: "none",
    strip: { none: true },
    relative_install_path: "recovery/root/system/lib64",
}

cc_prebuilt_library_shared {
    name: "vendor.sprd.hardware.boot@1.2_recovery",
    vendor: true,
    srcs: ["proprietary/vendor_boot/ramdisk/system/lib64/vendor.sprd.hardware.boot@1.2.so"],
    compile_multilib: "64",
    stl: "none",
    strip: { none: true },
    relative_install_path: "recovery/root/system/lib64",
}

