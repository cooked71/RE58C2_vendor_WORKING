// Prebuilt service binaries
prebuilt_binary {
    name: "android.hardware.boot@1.2-service",
    src: "$(PROPRIETARY_PATH)/vendor/bin/hw/vendor.sprd.hardware.boot@1.2-service",
    vendor: true,
    sdk_version: "current",
    relative_install_path: "bin/hw",
}

prebuilt_binary {
    name: "android.hardware.boot@1.2-service.recovery",
    src: "$(PROPRIETARY_PATH)/vendor/bin/hw/vendor.sprd.hardware.boot@1.2-service_2",
    vendor: true,
    sdk_version: "current",
    relative_install_path: "recovery/root/vendor/bin/hw",
}

// Prebuilt implementation libraries
prebuilt_shared_library {
    name: "android.hardware.boot@1.2-impl",
    srcs: ["$(PROPRIETARY_PATH)/vendor/lib64/hw/android.hardware.boot@1.0-impl-1.2.so",
           "$(PROPRIETARY_PATH)/vendor/lib/hw/android.hardware.boot@1.0-impl-1.2.so"],
    vendor: true,
    sdk_version: "current",
    compile_multilib: "both",
    relative_install_path: "lib/hw",
}

prebuilt_shared_library {
    name: "android.hardware.boot@1.2-impl.recovery",
    srcs: ["$(PROPRIETARY_PATH)/vendor_boot/ramdisk/system/lib64/hw/android.hardware.boot@1.0-impl-1.2.so"],
    vendor: true,
    sdk_version: "current",
    compile_multilib: "64",
    relative_install_path: "recovery/root/vendor/lib64/hw",
}

// Prebuilt interface libraries in vendor_boot
prebuilt_shared_library {
    name: "android.hardware.boot@1.2-iface",
    srcs: [
        "$(PROPRIETARY_PATH)/vendor_boot/ramdisk/system/lib64/android.hardware.boot@1.2.so",
        "$(PROPRIETARY_PATH)/vendor_boot/ramdisk/system/lib64/android.hardware.boot@1.1.so",
        "$(PROPRIETARY_PATH)/vendor_boot/ramdisk/system/lib64/android.hardware.boot@1.0.so",
        "$(PROPRIETARY_PATH)/vendor_boot/ramdisk/system/lib64/vendor.sprd.hardware.boot@1.2.so"
    ],
    vendor: true,
    sdk_version: "current",
    compile_multilib: "64",
    relative_install_path: "recovery/root/system/lib64",
}

// Prebuilt bootctrl libraries
prebuilt_shared_library {
    name: "bootctrl.default",
    srcs: [
        "$(PROPRIETARY_PATH)/vendor/lib64/hw/bootctrl.default.so",
        "$(PROPRIETARY_PATH)/vendor/lib/hw/bootctrl.default.so"
    ],
    vendor: true,
    sdk_version: "current",
    compile_multilib: "both",
    relative_install_path: "lib/hw",
}

prebuilt_shared_library {
    name: "bootctrl.default.recovery",
    srcs: [
        "$(PROPRIETARY_PATH)/vendor/lib64/hw/bootctrl.default.so",
        "$(PROPRIETARY_PATH)/vendor/lib/hw/bootctrl.default.so"
    ],
    vendor: true,
    sdk_version: "current",
    compile_multilib: "both",
    relative_install_path: "recovery/root/vendor/lib/hw",
}

prebuilt_shared_library {
    name: "unisoc.bootctrl",
    srcs: [
        "$(PROPRIETARY_PATH)/vendor/lib64/hw/unisoc.bootctrl.so",
        "$(PROPRIETARY_PATH)/vendor/lib/hw/unisoc.bootctrl.so"
    ],
    vendor: true,
    sdk_version: "current",
    compile_multilib: "both",
    relative_install_path: "lib/hw",
}

prebuilt_shared_library {
    name: "unisoc.bootctrl.recovery",
    srcs: [
        "$(PROPRIETARY_PATH)/vendor/lib64/hw/unisoc.bootctrl.so",
        "$(PROPRIETARY_PATH)/vendor/lib/hw/unisoc.bootctrl.so"
    ],
    vendor: true,
    sdk_version: "current",
    compile_multilib: "both",
    relative_install_path: "recovery/root/vendor/lib/hw",
}
