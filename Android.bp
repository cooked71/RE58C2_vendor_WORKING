// =============================================
// ABSOLUTELY ESSENTIAL SERVICES FOR BOOT
// =============================================
cc_prebuilt_binary {
    name: "android.hardware.graphics.composer@2.4-service",
    srcs: ["proprietary/vendor/bin/hw/android.hardware.graphics.composer@2.4-service"],
    relative_install_path: "hw",
    vendor: true,
    compile_multilib: "64",
    init_rc: ["proprietary/vendor/etc/init/android.hardware.graphics.composer@2.4-service.rc"],
    shared_libs: ["libbase", "libcutils", "libhidlbase", "liblog", "libutils", "libc++"],
}

// =============================================
// KEYMINT STACK (ESSENTIAL FOR ANDROID 13+)
// =============================================
cc_prebuilt_binary {
    name: "android.hardware.security.keymint@2.0-unisoc.service.trusty",
    srcs: ["proprietary/vendor/bin/hw/android.hardware.security.keymint@2.0-unisoc.service.trusty"],
    relative_install_path: "hw",
    vendor: true,
    compile_multilib: "64",
    init_rc: ["proprietary/vendor/etc/init/android.hardware.security.keymint@2.0-unisoc.service.trusty.rc"],
    shared_libs: [
        "libbase",
        "libcutils",
        "libhidlbase",
        "liblog",
        "libutils",
        "libc++",
        "android.hardware.security.keymint-V1-ndk",
        "libkeymint",
        "libkeymaster_portable",
        "libkeymaster_messages",
        "lib_android_keymaster_keymint_utils",
        "libpuresoftkeymasterdevice"
    ],
    check_elf_files: false,
}

