soong_namespace {
    imports: [],
}

// =============================================
// Prebuilt APKs - KEEP ESSENTIAL
// =============================================

android_app_import {
    name: "SoterService",
    owner: "realme",
    apk: "proprietary/system_ext/app/SoterService/SoterService.apk",
    certificate: "platform",
    dex_preopt: {
        enabled: false,
    },
    system_ext_specific: true,
}

android_app_import {
    name: "ims",
    owner: "realme",
    apk: "proprietary/system_ext/priv-app/ims/ims.apk",
    certificate: "platform",
    dex_preopt: {
        enabled: false,
    },
    privileged: true,
    system_ext_specific: true,
}

// =============================================
// Audio Stack - KEEP ESSENTIAL ONLY
// =============================================

cc_prebuilt_binary {
    name: "android.hardware.audio.service",
    owner: "realme",
    srcs: ["proprietary/vendor/bin/hw/android.hardware.audio.service"],
    relative_install_path: "hw",
    vendor: true,
    compile_multilib: "64",
    init_rc: ["proprietary/vendor/etc/init/android.hardware.audio.service.rc"],
    shared_libs: [
        "libbase",
        "libcutils",
        "libhidlbase",
        "liblog",
        "libutils",
        "libc++",
    ],
    check_elf_files: false,
}

prebuilt_etc {
    name: "audio_policy_configuration.xml",
    owner: "realme",
    src: "proprietary/odm/etc/audio/audio_policy_configuration.xml",
    sub_dir: "audio",
}

