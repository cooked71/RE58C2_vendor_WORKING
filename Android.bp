// =============================================
// LineageOS 20 - RE58C2 MINIMAL Android.bp
// Focus: BOOT TO SPLASH SCREEN ONLY
// =============================================
soong_namespace {
    imports: [],
}

// =============================================
// ABSOLUTELY ESSENTIAL SERVICES FOR BOOT
// =============================================

cc_prebuilt_binary {
    name: "android.hardware.graphics.composer@2.4-service",
    srcs: ["proprietary/vendor/bin/hw/android.hardware.graphics.composer@2.4-service"],
    relative_install_path: "hw",
    vendor: true,
    compile_multilib: "64",
    init_rc: ["proprietary/vendor/etc/init/android.hardware.graphics.composer@2.4-service.rc"],
    shared_libs: ["libbase", "libcutils", "libhidlbase", "liblog", "libutils", "libc++"],
}



// =============================================
// ESSENTIAL GRAPHICS LIBRARIES (SPLASH SCREEN)
// =============================================

cc_prebuilt_library_shared {
    name: "libGLES_mali",
    vendor: true,
    check_elf_files: false,
    multilib: {
        lib32: {
            srcs: ["proprietary/vendor/lib/egl/libGLES_mali.so"],
            relative_install_path: "egl",
        },
        lib64: {
            srcs: ["proprietary/vendor/lib64/egl/libGLES_mali.so"],
            relative_install_path: "egl",
        },
    },
    shared_libs: ["liblog", "libcutils", "libutils", "libc++"],
}

cc_prebuilt_library_shared {
    name: "hwcomposer.unisoc",
    vendor: true,
    check_elf_files: false,
    multilib: {
        lib32: {
            srcs: ["proprietary/vendor/lib/hw/hwcomposer.unisoc.so"],
            relative_install_path: "hw",
        },
        lib64: {
            srcs: ["proprietary/vendor/lib64/hw/hwcomposer.unisoc.so"],
            relative_install_path: "hw",
        },
    },
    shared_libs: ["liblog", "libcutils", "libutils", "libc++", "libhardware"],
}

// =============================================
// ESSENTIAL POWER MANAGEMENT
// =============================================

cc_prebuilt_library_shared {
    name: "power.default",
    vendor: true,
    multilib: {
        lib32: {
            srcs: ["proprietary/vendor/lib/hw/power.default.so"],
            relative_install_path: "hw",
        },
        lib64: {
            srcs: ["proprietary/vendor/lib64/hw/power.default.so"],
            relative_install_path: "hw",
        },
    },
    shared_libs: ["liblog", "libcutils", "libutils", "libc++"],
}

cc_prebuilt_library_shared {
    name: "vendor.unisoc.hardware.power-V1-ndk",
    srcs: ["proprietary/vendor/lib64/vendor.unisoc.hardware.power-V1-ndk.so"],
    vendor: true,
    compile_multilib: "64",
    shared_libs: ["libbinder_ndk", "libc++", "liblog", "libutils"],
}

// =============================================
// ESSENTIAL BOOT COMPONENTS
// =============================================

cc_prebuilt_binary {
    name: "android.hardware.boot@1.2-service",
    srcs: ["proprietary/vendor/bin/hw/vendor.sprd.hardware.boot@1.2-service"],
    relative_install_path: "hw",
    vendor: true,
    compile_multilib: "64",
    init_rc: ["proprietary/vendor/etc/init/vendor.sprd.hardware.boot@1.2-service.rc"],
    shared_libs: ["libbase", "libcutils", "libhidlbase", "liblog", "libutils", "libc++"],
}

cc_prebuilt_library_shared {
    name: "android.hardware.boot@1.2-impl",
    vendor: true,
    multilib: {
        lib32: {
            srcs: ["proprietary/vendor/lib/hw/android.hardware.boot@1.0-impl-1.2.so"],
            relative_install_path: "hw",
        },
        lib64: {
            srcs: ["proprietary/vendor/lib64/hw/android.hardware.boot@1.0-impl-1.2.so"],
            relative_install_path: "hw",
        },
    },
    shared_libs: ["liblog", "libcutils", "libutils", "libc++"],
}

// =============================================
// ESSENTIAL INIT SCRIPTS
// =============================================

prebuilt_etc {
    name: "init_RE58C2",
    src: "proprietary/vendor/etc/init/hw/init.RE58C2.rc",
    vendor: true,
    sub_dir: "hw",
}

prebuilt_etc {
    name: "init_ram",
    src: "proprietary/vendor/etc/init/hw/init.ram.rc",
    vendor: true,
    sub_dir: "hw",
}

// =============================================
// ABSOLUTE MINIMAL VINTF MANIFESTS
// =============================================

prebuilt_etc {
    name: "manifest_vendor.unisoc.power",
    src: "proprietary/vendor/etc/vintf/manifest/vendor-power-default.xml",
    sub_dir: "vintf/manifest",
    vendor: true,
}
// =============================================
// COMPLETE GRALLOC STACK
// =============================================

cc_prebuilt_library_shared {
    name: "gralloc.default",
    vendor: true,
    multilib: {
        lib32: {
            srcs: ["proprietary/vendor/lib/hw/gralloc.default.so"],
            relative_install_path: "hw",
        },
        lib64: {
            srcs: ["proprietary/vendor/lib64/hw/gralloc.default.so"],
            relative_install_path: "hw",
        },
    },
    shared_libs: [
        "liblog",
        "libcutils", 
        "libutils",
        "libc++",
        "libhardware",
        "libgralloctypes",  // Add this dependency
    ],
}

cc_prebuilt_library_shared {
    name: "libgralloctypes",
    vendor: true,
    multilib: {
        lib32: {
            srcs: ["proprietary/system/lib/libgralloctypes.so"],
        },
        lib64: {
            srcs: ["proprietary/system/lib64/libgralloctypes.so"],
        },
    },
    shared_libs: [
        "liblog",
        "libcutils",
        "libutils",
        "libc++",
    ],
}

prebuilt_etc {
    name: "gralloc_config",
    src: "proprietary/vendor/etc/gralloc/gralloc.xml",
    sub_dir: "gralloc",
    vendor: true,
}
// =============================================
// HAL Services (CORRECTED)
// =============================================

// Gatekeeper Service
cc_prebuilt_binary {
    name: "android.hardware.gatekeeper@1.0-service.trusty",
    srcs: ["proprietary/vendor/bin/hw/android.hardware.gatekeeper@1.0-service.trusty"],
    relative_install_path: "hw",
    vendor: true,
    compile_multilib: "64",
    init_rc: ["proprietary/vendor/etc/init/android.hardware.gatekeeper@1.0-service.trusty.rc"],
    shared_libs: [
        "android.hardware.gatekeeper@1.0",
        "libbase",
        "libcutils",
        "libhidlbase",
        "liblog",
        "libutils",
        "libc++",
    ],
}

// Health Service
cc_prebuilt_binary {
    name: "android.hardware.health-service.example",
    srcs: ["proprietary/vendor/bin/hw/android.hardware.health-service.example"],
    relative_install_path: "hw",
    vendor: true,
    compile_multilib: "64",
    init_rc: ["proprietary/vendor/etc/init/android.hardware.health-service.example.rc"],
    shared_libs: [
        "libbase",
        "libcutils",
        "libhidlbase",
        "liblog",
        "libutils",
        "libc++",
    ],
}

// power.sprd (vendor library)
cc_prebuilt_library_shared {
    name: "power.sprd",
    vendor: true,
    check_elf_files: false,
    multilib: {
        lib64: {
            srcs: ["proprietary/vendor/lib64/power.sprd.so"],
        },
    },
    shared_libs: ["libc++", "liblog", "libutils", "libcutils"],
}

cc_prebuilt_binary {
    name: "vendor.unisoc.hardware.power-service",
    check_elf_files: false,  // ← ADD THIS to skip ELF checking
    srcs: ["proprietary/vendor/bin/hw/vendor.unisoc.hardware.power-service"],
    relative_install_path: "hw",
    vendor: true,
    compile_multilib: "64",
    init_rc: ["proprietary/vendor/etc/init/vendor-power-default.rc"],
    shared_libs: [
        "vendor.unisoc.hardware.power-V1-ndk",
        "power.default",
        "libbase",
        "libcutils", 
        "libhidlbase",
        "liblog",
        "libutils",
        "libc++",
        "libbinder",           // ← AOSP system library
        "libbinder_ndk",       // ← AOSP system library
        "power.sprd",          // ← Vendor prebuilt (now declared above)
        // "android.hardware.power-V3-ndk" ← SYSTEM library (built from source)
    ],
}
// Gatekeeper Interface - KEEP (exists in vendor)
cc_prebuilt_library_shared {
    name: "android.hardware.gatekeeper@1.0",
    srcs: ["proprietary/vendor/lib64/android.hardware.gatekeeper@1.0.so"],
    vendor: true,
    compile_multilib: "64",
    shared_libs: [
        "libhidlbase",
        "liblog",
        "libutils",
        "libcutils",
        "libc++",
    ],
}

// VINTF Manifests
prebuilt_etc {
    name: "android.hardware.gatekeeper@1.0-service.trusty.manifest",
    src: "proprietary/vendor/etc/vintf/manifest/android.hardware.gatekeeper@1.0-service.trusty.xml",
    sub_dir: "vintf/manifest",
    vendor: true,
}

prebuilt_etc {
    name: "android.hardware.health-service.example.manifest",
    src: "proprietary/vendor/etc/vintf/manifest/android.hardware.health-service.example.xml",
    sub_dir: "vintf/manifest",
    vendor: true,
}

prebuilt_etc {
