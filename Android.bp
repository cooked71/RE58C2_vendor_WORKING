// RE58C2 Android.bp - Corrected Vendor Implementation
soong_namespace {
    imports: [],
}

// =============================================
// Vendor-specific library definitions (ADD THESE FIRST)
// =============================================

// libmemion (vendor)
cc_prebuilt_library_shared {
    name: "libmemion",
    vendor: true,
    check_elf_files: false,
    multilib: {
        lib32: {
            srcs: ["proprietary/vendor/lib/libmemion.so"],
        },
        lib64: {
            srcs: ["proprietary/vendor/lib64/libmemion.so"],
        },
    },
    shared_libs: ["libc++", "liblog", "libutils", "libcutils"],
}

